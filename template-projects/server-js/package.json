{
  "name": "@gasbombe/server-js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/app.js",
  "scripts": {
    "check": "biome check --write",
    "build": "rolldown -c && cpy src/*.json dist/",
    "test": "vitest run --coverage",
    "push": "clasp push",
    "deploy": "clasp create-deployment",
    "update": "dotenv cross-var \"clasp update-deployment $GAS_DEPLOYMENT_ID\""
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@google/clasp": "catalog:",
    "@types/google-apps-script": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cpy-cli": "catalog:",
    "cross-var": "catalog:",
    "dotenv-cli": "catalog:",
    "rolldown": "catalog:",
    "rolldown-plugin-remove-export": "catalog:",
    "vitest": "catalog:"
  }
}
